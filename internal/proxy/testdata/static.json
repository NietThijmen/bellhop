{
  "admin": {
    "config": {
      "persist": false
    },
    "disabled": true
  },
  "apps": {
    "http": {
      "servers": {
        "sites": {
          "automatic_https": {
            "disable": true
          },
          "listen": [
            "127.0.0.1:8080"
          ],
          "logs": {
            "logger_names": {
              "*.static.localhost": [
                "static"
              ],
              "static.localhost": [
                "static"
              ]
            },
            "skip_unmapped_hosts": true
          },
          "protocols": [
            "h1"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "request_body",
                  "max_size": 536870912
                }
              ]
            },
            {
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "handler": "vars",
                          "root": "/srv/static"
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "handler": "static_response",
                          "status_code": 404
                        }
                      ],
                      "match": [
                        {
                          "not": [
                            {
                              "path": [
                                "/.well-known/*"
                              ]
                            }
                          ],
                          "path": [
                            "*/.*",
                            "*.sql",
                            "*.sqlite",
                            "*.sqlite3",
                            "*.log",
                            "*.bak",
                            "*.old",
                            "*.orig",
                            "*.save",
                            "*.swp",
                            "*~",
                            "/vendor/*",
                            "/node_modules/*",
                            "/composer.lock",
                            "/auth.json"
                          ]
                        }
                      ],
                      "terminal": true
                    },
                    {
                      "group": "try_static",
                      "handle": [
                        {
                          "handler": "rewrite",
                          "uri": "{http.matchers.file.relative}"
                        }
                      ],
                      "match": [
                        {
                          "file": {
                            "root": "/srv/static",
                            "try_files": [
                              "{http.request.uri.path}",
                              "{http.request.uri.path}/index.html",
                              "{http.request.uri.path}.html",
                              "=404"
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "handler": "file_server",
                          "index_names": [
                            "index.html"
                          ],
                          "root": "/srv/static"
                        }
                      ]
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "static.localhost",
                    "*.static.localhost"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "body": "no such site\n",
                  "handler": "static_response",
                  "status_code": 404
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    }
  },
  "logging": {
    "logs": {
      "static": {
        "encoder": {
          "format": "json"
        },
        "include": [
          "http.log.access.static"
        ],
        "writer": {
          "filename": "/var/log/bellhop/sites/static.log",
          "output": "file",
          "roll": false
        }
      }
    }
  }
}
