{
  "admin": {
    "config": {
      "persist": false
    },
    "disabled": true
  },
  "apps": {
    "http": {
      "servers": {
        "sites": {
          "automatic_https": {
            "disable": true
          },
          "listen": [
            "127.0.0.1:8080"
          ],
          "logs": {
            "logger_names": {
              "*.laravel.localhost": [
                "laravel"
              ],
              "laravel.localhost": [
                "laravel"
              ]
            },
            "skip_unmapped_hosts": true
          },
          "protocols": [
            "h1"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "request_body",
                  "max_size": 536870912
                }
              ]
            },
            {
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "handler": "vars",
                          "root": "/srv/laravel/public"
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "handler": "static_response",
                          "status_code": 404
                        }
                      ],
                      "match": [
                        {
                          "not": [
                            {
                              "path": [
                                "/.well-known/*"
                              ]
                            }
                          ],
                          "path": [
                            "*/.*",
                            "*.sql",
                            "*.sqlite",
                            "*.sqlite3",
                            "*.log",
                            "*.bak",
                            "*.old",
                            "*.orig",
                            "*.save",
                            "*.swp",
                            "*~"
                          ]
                        }
                      ],
                      "terminal": true
                    },
                    {
                      "group": "try_laravel",
                      "handle": [
                        {
                          "handler": "rewrite",
                          "uri": "{http.matchers.file.relative}"
                        }
                      ],
                      "match": [
                        {
                          "file": {
                            "root": "/srv/laravel/public",
                            "split_path": [
                              ".php"
                            ],
                            "try_files": [
                              "{http.request.uri.path}",
                              "{http.request.uri.path}/index.php",
                              "{http.request.uri.path}/index.html",
                              "{http.request.uri.path}/"
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "group": "try_laravel",
                      "handle": [
                        {
                          "handler": "rewrite",
                          "uri": "{http.matchers.file.relative}?{http.request.uri.query}"
                        }
                      ],
                      "match": [
                        {
                          "file": {
                            "root": "/srv/laravel/public",
                            "split_path": [
                              ".php"
                            ],
                            "try_files": [
                              "/index.php"
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "transport": {
                            "env": {
                              "SERVER_NAME": "{http.request.host}"
                            },
                            "protocol": "fastcgi",
                            "root": "/srv/laravel/public",
                            "split_path": [
                              ".php"
                            ]
                          },
                          "upstreams": [
                            {
                              "dial": "unix//run/php-8.3.sock"
                            }
                          ]
                        }
                      ],
                      "match": [
                        {
                          "path": [
                            "*.php"
                          ]
                        }
                      ],
                      "terminal": true
                    },
                    {
                      "handle": [
                        {
                          "handler": "file_server",
                          "index_names": [
                            "index.php",
                            "index.html"
                          ],
                          "root": "/srv/laravel/public"
                        }
                      ]
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "laravel.localhost",
                    "*.laravel.localhost"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "body": "no such site\n",
                  "handler": "static_response",
                  "status_code": 404
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    }
  },
  "logging": {
    "logs": {
      "laravel": {
        "encoder": {
          "format": "json"
        },
        "include": [
          "http.log.access.laravel"
        ],
        "writer": {
          "filename": "/var/log/bellhop/sites/laravel.log",
          "output": "file",
          "roll": false
        }
      }
    }
  }
}
